# Connexion base de données — SEULE variable à changer pour migrer d'hôte
# (Vercel, Hostinger, VPS, peu importe : rien d'autre n'est spécifique à un hébergeur).
DATABASE_URL="postgresql://user:password@host:5432/gestion?schema=public"

# Secret de session Auth.js (générer : openssl rand -base64 32)
AUTH_SECRET="change-me-32-bytes-random"

# En production derrière HTTPS, laisser vide (déduit). En local : http://localhost:3000
AUTH_URL="http://localhost:3000"

# Comptes initiaux créés par le seed (jamais de mot de passe en dur dans le code)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-strong-admin"
SEED_READER_EMAIL="reader@example.com"
SEED_READER_PASSWORD="change-me-strong-reader"
