# Modèle de variables d'environnement — backend Supabase.
# Copier en `.env` et renseigner les valeurs. NE JAMAIS committer le `.env`.
# Les clés référencées ici le sont par supabase/config.toml.

# --- Auth : OTP SMS (Twilio) — activé à l'étape Authentification ---
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- Auth : Sign in with Apple (préparé) — requis pour activer le provider ---
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Auth : Sign in with Google (préparé, V2) — requis pour activer le provider ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Studio (optionnel) : assistant IA local ---
OPENAI_API_KEY=
