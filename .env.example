# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barberhome?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="change-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Realtime — Supabase (Phase 3). Empty ⇒ realtime is inert, app runs unchanged.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Signs per-reservation channel tokens (falls back to AUTH_SECRET)
REALTIME_CHANNEL_SECRET=""

# Payment — Stripe (Phase 3). Empty ⇒ a mock provider is used (no charges).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Maps: "svg" (default, self-contained) or "leaflet"/"google" once configured
NEXT_PUBLIC_MAPS_PROVIDER="svg"
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Notifications — Email / SMS (empty ⇒ console/dev providers, nothing sent)
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# In-app audio calls (Phase 5). Empty / not "twilio" ⇒ mock demo provider.
# Set CALL_PROVIDER=twilio + the Voice API keys below to go live.
CALL_PROVIDER="mock"
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_TWIML_APP_SID=""

# Observability (empty ⇒ logging only, Sentry inert). See docs/DEPLOYMENT.md
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
