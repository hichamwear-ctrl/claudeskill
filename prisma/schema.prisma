// Barber Home — Prisma schema
// The "Uber for at-home barbers"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum ReservationStatus {
  DEMANDE_ENVOYEE
  ACCEPTEE
  BARBER_ATTRIBUE
  EN_ROUTE
  ARRIVE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum PaymentMethod {
  ONLINE
  ON_SITE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PersonType {
  ADULTE
  ENFANT
}

// Service keys map to the fixed catalogue (see lib/pricing.ts)
enum ServiceKey {
  ADULTE_COUPE
  ADULTE_COUPE_BARBE
  ENFANT_COUPE
}

enum NotificationChannel {
  EMAIL
  SMS
  REALTIME
}

// Phase 5 — barber seniority tiers shown on the public profile.
enum BarberLevel {
  JUNIOR
  CONFIRME
  EXPERT
}

// Phase 5 — a barber account only goes live after an admin validates it.
enum BarberApprovalStatus {
  PENDING
  APPROVED
  REFUSED
}

// Phase 5 — end-of-order client feedback that needs human follow-up.
enum ReportType {
  PROBLEM
  HELP
}

enum CallStatus {
  INITIATED
  ONGOING
  ENDED
  MISSED
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  username     String?  @unique
  firstName    String
  lastName     String
  passwordHash String
  image        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loyaltyPoints Int @default(0)

  addresses     Address[]
  reservations  Reservation[]        @relation("ClientReservations")
  barberProfile Barber?
  reviews       Review[]             @relation("AuthorReviews")
  notifications Notification[]
  invoices      Invoice[]
  favorites     Favorite[]
  loyaltyTxns   LoyaltyTransaction[]
  sentMessages  Message[]            @relation("SentMessages")
  reportsMade   Report[]             @relation("ReportedBy")
  authoredNotes AdminNote[]          @relation("AuthoredNotes")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Domicile")
  street     String
  number     String?
  city       String
  postalCode String
  country    String   @default("Belgique")
  latitude   Float?
  longitude  Float?
  insideZone Boolean  @default(true)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([userId])
}

model Barber {
  id            String   @id @default(cuid())
  userId        String   @unique
  bio           String?
  rating        Float    @default(5)
  totalJobs     Int      @default(0)
  isAvailable   Boolean  @default(true)
  currentLat    Float?
  currentLng    Float?
  serviceRadius Int      @default(15) // km
  createdAt     DateTime @default(now())

  // Phase 5 — public profile & onboarding
  yearsExperience Int                  @default(0)
  level           BarberLevel          @default(JUNIOR)
  instagram       String?
  snapchat        String?
  approvalStatus  BarberApprovalStatus @default(APPROVED)
  bannedAt        DateTime?
  suspendedAt     DateTime?

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  availabilities   Availability[]
  workingHours     WorkingHours[]
  unavailabilities Unavailability[]
  reviews          Review[]
  favoritedBy      Favorite[]
  photos           BarberPhoto[]
  reports          Report[]
  adminNotes       AdminNote[]

  @@index([isAvailable])
  @@index([approvalStatus])
}

// Phase 5 — a barber's portfolio of past cuts.
model BarberPhoto {
  id        String   @id @default(cuid())
  barberId  String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
}

model Reservation {
  id                String            @id @default(cuid())
  reference         String            @unique @default(cuid())
  clientId          String
  barberId          String?
  addressId         String
  status            ReservationStatus @default(DEMANDE_ENVOYEE)
  scheduledAt       DateTime
  durationMinutes   Int
  subtotal          Float
  travelFee         Float             @default(0)
  discount          Float             @default(0)
  total             Float
  // Access details
  notes             String?
  digicode          String?
  floor             String?
  parking           String?
  // Phase 5 — barbers who declined or were refused, so they aren't re-offered.
  declinedBarberIds String[]          @default([])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  client      User                @relation("ClientReservations", fields: [clientId], references: [id], onDelete: Cascade)
  barber      Barber?             @relation(fields: [barberId], references: [id])
  address     Address             @relation(fields: [addressId], references: [id])
  persons     ReservationPerson[]
  payment     Payment?
  invoice     Invoice?
  review      Review?
  messages    Message[]
  reports     Report[]
  calls       CallSession[]
  promoCode   PromoCode?          @relation(fields: [promoCodeId], references: [id])
  promoCodeId String?

  @@index([clientId])
  @@index([barberId])
  @@index([status])
  @@index([scheduledAt])
}

model ReservationPerson {
  id            String     @id @default(cuid())
  reservationId String
  type          PersonType
  service       ServiceKey
  price         Float
  duration      Int
  label         String?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

// Catalogue reference (also encoded in lib/pricing.ts for pure calculations)
model Service {
  id       String     @id @default(cuid())
  key      ServiceKey @unique
  name     String
  type     PersonType
  price    Float
  duration Int
  active   Boolean    @default(true)
}

model Payment {
  id             String        @id @default(cuid())
  reservationId  String        @unique
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Float
  stripeIntentId String?
  createdAt      DateTime      @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique
  reservationId String   @unique
  userId        String
  amount        Float
  pdfUrl        String?
  issuedAt      DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Review {
  id            String   @id @default(cuid())
  reservationId String   @unique
  authorId      String
  barberId      String
  rating        Int
  comment       String?
  photo         String?
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  author      User        @relation("AuthorReviews", fields: [authorId], references: [id])
  barber      Barber      @relation(fields: [barberId], references: [id])

  @@index([barberId])
}

// ---------------------------------------------------------------------------
// Phase 5 — chat, calls, moderation
// ---------------------------------------------------------------------------

model Message {
  id            String    @id @default(cuid())
  reservationId String
  senderId      String
  body          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  sender      User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

model CallSession {
  id            String     @id @default(cuid())
  reservationId String
  initiatorId   String
  provider      String     @default("mock")
  status        CallStatus @default(INITIATED)
  room          String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model Report {
  id            String     @id @default(cuid())
  reservationId String?
  barberId      String?
  reporterId    String
  type          ReportType @default(PROBLEM)
  message       String
  resolvedAt    DateTime?
  createdAt     DateTime   @default(now())

  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  barber      Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)
  reporter    User         @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
}

model AdminNote {
  id        String   @id @default(cuid())
  barberId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  author User   @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([barberId])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(REALTIME)
  title     String
  body      String
  read      Boolean             @default(false)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  percentOff  Int?
  amountOff   Float?
  active      Boolean   @default(true)
  expiresAt   DateTime?
  maxUses     Int?
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  reservations Reservation[]
}

model Availability {
  id        String   @id @default(cuid())
  barberId  String
  date      DateTime
  startTime String // "09:00"
  endTime   String // "18:00"
  isBooked  Boolean  @default(false)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, date])
}

model WorkingHours {
  id        String  @id @default(cuid())
  barberId  String
  weekday   Int // 0 = Sunday .. 6 = Saturday
  startTime String
  endTime   String
  enabled   Boolean @default(true)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
}

// ---------------------------------------------------------------------------
// Phase 3 — favorites, loyalty, barber time-off
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  barberId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([userId, barberId])
  @@index([userId])
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  points    Int // positive = earned, negative = redeemed
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UnavailabilityType {
  BREAK
  LEAVE
  OFF
}

model Unavailability {
  id        String             @id @default(cuid())
  barberId  String
  date      DateTime
  allDay    Boolean            @default(true)
  startTime String?
  endTime   String?
  type      UnavailabilityType @default(OFF)
  reason    String?
  createdAt DateTime           @default(now())

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, date])
}
