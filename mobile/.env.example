# Variables publiques de l'app Expo (aucune valeur secrète).
# Copier en `.env` (git-ignoré) et renseigner depuis le projet Supabase de démo
# (cf. docs/EXPO_DEMO_SETUP.md §2).

EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Version de contrat envoyée aux Edge Functions (défaut : 1).
EXPO_PUBLIC_API_VERSION=1
